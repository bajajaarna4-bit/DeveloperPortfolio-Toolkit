# SONORA AI Environment Configuration

# Application
NEXT_PUBLIC_APP_NAME="SONORA AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Reasoning & Theory (OpenAI, Gemini, or Local)
# Optional: If not provided, built-in Music Theory Engine handles prompt interpretation & specification
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Music Generation Providers
# Optional: If not provided, high-fidelity Web Audio & Tone.js Synthesis Engine runs locally
REPLICATE_API_TOKEN=""
ELEVENLABS_API_KEY=""

# Supabase (Database, Auth, Storage)
# Optional: If not provided, client auto-falls back to resilient In-Memory & Local Database
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
